<resources>
    <!-- Debug Overlay Text -->
    <string name="debug_text_physical_camera_id_prefix">Physical ID: </string>
    <string name="debug_text_logical_camera_id_prefix">Logical ID: </string>
    <string name="debug_overlay_toggle_btn_text">Debug</string>
    <string name="debug_hide_components_desc">Hiding components</string>
    <string name="debug_show_components_desc">Displaying components</string>
    <string name="debug_zoom_ratio_text">%1$.2fx</string>
    <!-- Label prefix for the target video encoding bitrate in the debug overlay menu. [CHAR LIMIT=NONE] -->
    <string name="debug_text_video_bitrate_prefix">Target video bitrate: </string>
    <!-- Label prefix for the target audio encoding bitrate in the debug overlay menu. [CHAR LIMIT=NONE] -->
    <string name="debug_text_audio_bitrate_prefix">Target audio bitrate: </string>
    <!-- Default value displayed in the debug overlay when no custom bitrate is set. [CHAR LIMIT=NONE] -->
    <string name="debug_text_bitrate_default">Default</string>
    <!-- Formatted target bitrate in bits per second (%1$d) in the debug overlay menu. [CHAR LIMIT=NONE] -->
    <string name="debug_text_bitrate_bps">%1$d bps</string>
    <!-- Button label to open the dialog for setting custom video and audio encoding bitrates in the debug overlay. [CHAR LIMIT=40] -->
    <string name="debug_set_bitrate_btn_text">Set Bitrate</string>
    <!-- Label in the debug dialog for entering a custom video bitrate in bps (or leaving empty for default). [CHAR LIMIT=NONE] -->
    <string name="debug_set_video_bitrate_dialog_prompt">Video bitrate in bps (empty for default)</string>
    <!-- Label in the debug dialog for entering a custom audio bitrate in bps (or leaving empty for default). [CHAR LIMIT=NONE] -->
    <string name="debug_set_audio_bitrate_dialog_prompt">Audio bitrate in bps (empty for default)</string>
    <!-- Supporting hint showing the default encoding bitrate in bits per second (%1$d). [CHAR LIMIT=NONE] -->
    <string name="debug_bitrate_default_hint">Default: %1$d bps</string>
    <!-- Supporting hint showing the supported encoder bitrate range from %1$d to %2$d bits per second. [CHAR LIMIT=NONE] -->
    <string name="debug_bitrate_range_hint">Range: %1$d–%2$d bps</string>
    <!-- Button label to confirm the input value in a debug overlay dialog. [CHAR LIMIT=20] -->
    <string name="debug_dialog_confirm_btn_text">Confirm</string>
    <!-- Action label to close or dismiss a debug overlay dialog. [CHAR LIMIT=20] -->
    <string name="debug_dialog_close_btn_text">Close</string>
</resources>
