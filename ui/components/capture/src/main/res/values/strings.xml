    <string name="quick_settings_aspect_ratio_1_1_description" tools:ignore="HardCodedNumber">1 to 1 aspect ratio</string>

    <!-- Subtitle under the "HDR" row title in the quick settings bottom sheet on the capture screen, showing the current selection when HDR is off. "SDR" is the abbreviation for standard dynamic range and is normally left untranslated. [CHAR LIMIT=15] -->
    <string name="quick_settings_dynamic_range_sdr">SDR</string>
    <!-- Subtitle under the "HDR" row title in the quick settings bottom sheet on the capture screen, showing the current selection when HDR is on. "HDR" is the abbreviation for high dynamic range and is normally left untranslated. [CHAR LIMIT=15] -->
    <string name="quick_settings_dynamic_range_hdr">HDR</string>
    <!-- Accessibility label for the Standard Dynamic Range (SDR) option in quick settings. [CHAR LIMIT=NONE] -->
    <string name="quick_settings_dynamic_range_sdr_description">Standard dynamic range</string>
    <!-- Accessibility label for the High Dynamic Range (HDR) option in quick settings. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=NONE] -->
    <string name="quick_settings_dynamic_range_hdr_description">High dynamic range</string>

    <!-- Short option label in quick settings indicating camera flash is turned off. [CHAR LIMIT=15] -->
    <string name="quick_settings_flash_off">Off</string>
    <!-- Short option label in quick settings indicating camera flash is set to automatic. [CHAR LIMIT=15] -->
    <string name="quick_settings_flash_auto">Auto</string>
    <!-- Short option label in quick settings indicating camera flash is turned on. [CHAR LIMIT=15] -->
    <string name="quick_settings_flash_on">On</string>
    <!-- Short abbreviated option label in quick settings for Low Light Boost mode. [CHAR LIMIT=15] -->
    <string name="quick_settings_flash_llb">LLB</string>

    <!-- Accessibility label for the flash control when flash is turned off. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=NONE] -->
    <string name="quick_settings_flash_off_description">Flash off</string>
    <!-- Accessibility label for the flash control when flash is set to automatic. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=NONE] -->
    <string name="quick_settings_flash_auto_description">Auto flash</string>
    <!-- Accessibility label for the flash control when flash is turned on. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=NONE] -->
    <string name="quick_settings_flash_on_description">Flash on</string>
    <!-- Accessibility label for the flash control when Low Light Boost mode is enabled. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=NONE] -->
    <string name="quick_settings_flash_llb_description">Low Light Boost on</string>

    <!-- Toast (brief pop-up message at the bottom of the capture screen) shown when the Low Light Boost flash mode fails while the camera is running. "Low Light Boost" is a feature name; translate it consistently with flash_mode_selector_llb. [CHAR LIMIT=80] -->
    <string name="low_light_boost_error_toast_message">An error occurred when running Low Light Boost.</string>
    <!-- Subtitle under the "Capture Mode" row title in the quick settings bottom sheet on the capture screen, showing the current selection when hybrid mode is active (the options themselves are icon-only buttons). In hybrid mode a tap on the capture button takes a photo and a long press records a video. "Hybrid" means combined photo-and-video; "Capture" is a noun. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=25] -->
    <string name="quick_settings_text_capture_mode_standard">Hybrid Capture</string>
    <!-- Subtitle under the "Capture Mode" row title in the quick settings bottom sheet on the capture screen, showing the current selection when the camera can only record videos (no photos). "Only" restricts "Video"; "Video" is a noun. [CHAR LIMIT=25] -->
    <string name="quick_settings_text_capture_mode_video_only">Video Only</string>
    <!-- Subtitle under the "Capture Mode" row title in the quick settings bottom sheet on the capture screen, showing the current selection when the camera can only take photos (no video). "Only" restricts "Image"; "Image" means photo. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=25] -->
    <string name="quick_settings_text_capture_mode_image_only">Image Only</string>
    <!-- Accessibility label for the icon-only hybrid capture mode button in the "Capture Mode" row of the quick settings bottom sheet; in hybrid mode a tap on the capture button takes a photo and a long press records a video. Use the same term as the visible "Hybrid Capture" subtitle (quick_settings_text_capture_mode_standard). [CHAR LIMIT=NONE] -->
    <string name="quick_settings_description_capture_mode_standard">Hybrid capture</string>
    <!-- Accessibility label for the icon-only video-only capture mode button in the "Capture Mode" row of the quick settings bottom sheet. Use the same term as the visible "Video Only" subtitle (quick_settings_text_capture_mode_video_only). [CHAR LIMIT=NONE] -->
    <string name="quick_settings_description_capture_mode_video_only">Video only capture</string>
    <!-- Accessibility label for the icon-only photo-only capture mode button in the "Capture Mode" row of the quick settings bottom sheet. Use the same term as the visible "Image Only" subtitle (quick_settings_text_capture_mode_image_only). [CHAR LIMIT=NONE] -->
    <string name="quick_settings_description_capture_mode_image_only">Image only capture</string>

    <!-- Button label in the quick settings panel that navigates to the full camera settings screen. [CHAR LIMIT=25] -->
    <string name="quick_settings_more_text">More Settings</string>

    <!-- Accessibility label for the thumbnail preview button (image well) that opens the most recently captured photo or video. [CHAR LIMIT=NONE] -->
    <string name="image_well_content_description">View recently saved media</string>

    <!-- Accessibility label for the capture button while the camera is in photo mode. Activating the button takes a photo. [CHAR LIMIT=NONE] -->
    <string name="capture_button_capture_photo">Capture Photo</string>
    <!-- Accessibility label for the large round capture button on the capture screen when the camera is in video-only mode and idle; also the label of the long-press accessibility action in hybrid mode ("double-tap and hold to Start Video Recording"). Imperative verb phrase: activating starts recording a video. [CHAR LIMIT=NONE] -->
    <string name="capture_button_start_video_recording">Start Video Recording</string>
    <!-- Accessibility label for the large round capture button on the capture screen while the user is holding it down to record a video. Describes the current state ("a video is being recorded") as a present-progressive verb phrase; not a command and not a noun meaning "a video of a recording". [CHAR LIMIT=NONE] -->
    <string name="capture_button_recording_video">Recording Video</string>
    <!-- Accessibility label for the capture button while a video is being recorded. Activating the button stops the recording. [CHAR LIMIT=NONE] -->
    <string name="capture_button_stop_video_recording">Stop Video Recording</string>
    <!-- Accessibility label for the control that locks video recording, so the user can keep recording without holding down the capture button. [CHAR LIMIT=NONE] -->
    <string name="capture_button_lock_video_recording">Lock Video Recording</string>
    <!-- Accessibility label for the capture button when it is disabled, for example while the camera is busy, and cannot be activated. "Capture" is used as an action verb (to take a photo or record a video), not a noun. [CHAR LIMIT=NONE] -->
    <string name="capture_button_unavailable">Capture</string>

    <!-- Accessibility label for the live camera viewfinder surface where the user can tap to focus. "Camera" is a generic term. [CHAR LIMIT=NONE] -->
    <string name="camera_viewfinder_content_description">Camera viewfinder</string>

    <!-- Accessibility announcement when the camera is actively focusing on a tapped point in the viewfinder. [CHAR LIMIT=NONE] -->
    <string name="focus_scanning">Focusing</string>
    <!-- Accessibility announcement (not shown visually) when the camera has successfully focused on the point the user tapped in the viewfinder. "Focused" is a past participle describing the camera's focus state (focus achieved), not a person concentrating. [CHAR LIMIT=NONE] -->
    <string name="focus_locked">Focused</string>
    <!-- Accessibility announcement when the camera fails to focus on the tapped point in the viewfinder. [CHAR LIMIT=NONE] -->
    <string name="focus_failed">Focus failed</string>
    <!-- Accessibility announcement (not shown visually) when the tap-to-focus point is cleared and the camera returns to automatic continuous focus. "Focus" is the noun (camera focus); "released" means the fixed focus point is no longer held. [CHAR LIMIT=NONE] -->
    <string name="focus_released">Focus released</string>
