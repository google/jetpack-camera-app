    <string name="quick_settings_title_photo_settings">Photo settings</string>
    <!-- Header title for the quick settings bottom sheet when both photo and video settings are shown. [CHAR LIMIT=40] -->
    <string name="quick_settings_title_photo_and_video_settings">Photo and video settings</string>

