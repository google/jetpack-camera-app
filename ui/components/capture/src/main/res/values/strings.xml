<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2" xmlns:tools="http://schemas.android.com/tools">
    <!-- Text displayed on the camera preview screen while the camera is initializing. "Camera" is a generic term. [CHAR LIMIT=30] -->
    <string name="camera_not_ready">Camera Loading…</string>
    <string name="elapsed_time_format" translatable="false">%1$d:%2$02d</string>
    <!-- Timer text on the capture screen while a video recording is paused, replacing the normal "m:ss" timer. "PAUSED" describes the recording and is shown in all capital letters for emphasis (use the target language's equivalent emphasis if all caps is not appropriate). %1$d is the elapsed minutes (e.g. 1) and %2$02d is the elapsed seconds zero-padded to two digits (e.g. 05), so the text reads e.g. "PAUSED 1:05". Keep the colon between minutes and seconds. [CHAR LIMIT=25] -->
    <string name="elapsed_time_format_paused">PAUSED <xliff:g id="minutes" example="1">%1$d</xliff:g>:<xliff:g id="seconds" example="05">%2$02d</xliff:g></string>
    <!-- Accessibility announcement (read aloud by screen readers, not shown visually) for the elapsed-time timer on the capture screen while a video is recording. %1$d is the elapsed minutes (e.g. 1) and %2$d is the remaining elapsed seconds (e.g. 30), so the text reads e.g. "Recording time: 1 minutes and 30 seconds". [CHAR LIMIT=NONE] -->
    <string name="elapsed_time_accessibility_recording" tools:ignore="PluralsCandidate">Recording time: <xliff:g id="minutes" example="1">%1$d</xliff:g> minutes and <xliff:g id="seconds" example="30">%2$d</xliff:g> seconds</string>
    <!-- Accessibility announcement (read aloud by screen readers, not shown visually) for the elapsed-time timer on the capture screen while the video recording is paused. %1$d is the elapsed minutes (e.g. 1) and %2$d is the remaining elapsed seconds (e.g. 30), so the text reads e.g. "Recording paused: 1 minutes and 30 seconds". [CHAR LIMIT=NONE] -->
    <string name="elapsed_time_accessibility_paused" tools:ignore="PluralsCandidate">Recording paused: <xliff:g id="minutes" example="1">%1$d</xliff:g> minutes and <xliff:g id="seconds" example="30">%2$d</xliff:g> seconds</string>

    <!-- Accessibility label for the toggle option to switch to photo capture mode. [CHAR LIMIT=NONE] -->
    <string name="capture_mode_image_capture_content_description">Image capture mode</string>
    <!-- Accessibility label for the toggle option to switch to video recording mode. [CHAR LIMIT=NONE] -->
    <string name="capture_mode_video_recording_content_description">Video recording mode</string>
    <!-- Accessibility label for the capture mode toggle when locked to photo capture mode only. [CHAR LIMIT=NONE] -->
    <string name="capture_mode_image_capture_content_description_disabled">Image capture mode only</string>
    <!-- Accessibility label for the capture mode toggle when locked to video recording mode only. [CHAR LIMIT=NONE] -->
    <string name="capture_mode_video_recording_content_description_disabled">Video recording mode only</string>

    <!-- Accessibility label for the button that pauses or resumes an active video recording. [CHAR LIMIT=NONE] -->
    <string name="pause_resume_button_description">Pause or resume video recording</string>
    <!-- Accessibility label for the microphone icon inside the round mute/unmute toggle button shown on the capture screen during video recording; the button's muted/on state is announced separately (microphone_muted / microphone_on). "Microphone" is a noun naming the control, not an action. [CHAR LIMIT=NONE] -->
    <string name="audio_visualizer_icon_description">Microphone</string>
    <!-- Accessibility state description for the microphone mute/unmute toggle button on the capture screen during video recording, read after the button name "Microphone" when audio is muted. "Muted" is an adjective describing the microphone. [CHAR LIMIT=NONE] -->
    <string name="microphone_muted">Muted</string>
    <!-- Accessibility state description for the microphone mute/unmute toggle button on the capture screen during video recording, read after the button name "Microphone" when audio is being recorded. "On" is a state value (the microphone is on), not an imperative verb. [CHAR LIMIT=NONE] -->
    <string name="microphone_on">On</string>

    <!-- Accessibility label (not shown visually) for the small status icon in the top bar of the capture screen when video stabilization is set to Auto and the app has turned stabilization on automatically. The implied subject of "on" is video stabilization; "on" is a state, not an action. [CHAR LIMIT=NONE] -->
    <string name="stabilization_icon_description_auto">Stabilization is on</string>
    <!-- Accessibility content description for the status icon indicating both camera preview and video recording are stabilized. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=NONE] -->
    <string name="stabilization_icon_description_preview_and_video">Preview is Stabilized</string>
    <!-- Accessibility content description for the status icon indicating only video recording is stabilized. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=NONE] -->
    <string name="stabilization_icon_description_video_only">Only Video is Stabilized</string>
    <!-- Accessibility content description for the status icon indicating optical image stabilization (OIS) is enabled. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=NONE] -->
    <string name="stabilization_icon_description_optical">Optical stabilization is Enabled</string>
    <!-- Accessibility label (not shown visually) for the status icon in the top bar of the capture screen when the video resolution is Standard Definition (SD, 480p). Spelled out in full because screen readers read abbreviations letter by letter. [CHAR LIMIT=NONE] -->
    <string name="video_quality_description_sd">Video quality is standard definition</string>
    <!-- Accessibility label (not shown visually) for the status icon in the top bar of the capture screen when the video resolution is High Definition (HD, 720p). Spelled out in full because screen readers read abbreviations letter by letter. [CHAR LIMIT=NONE] -->
    <string name="video_quality_description_hd">Video quality is high definition</string>
    <!-- Accessibility label (not shown visually) for the status icon in the top bar of the capture screen when the video resolution is Full High Definition (FHD, 1080p). Spelled out in full because screen readers read abbreviations letter by letter. [CHAR LIMIT=NONE] -->
    <string name="video_quality_description_fhd">Video quality is full high definition</string>
    <!-- Accessibility label (not shown visually) for the status icon in the top bar of the capture screen when the video resolution is Ultra High Definition (UHD, 4K/2160p). Spelled out in full because screen readers read abbreviations letter by letter. [CHAR LIMIT=NONE] -->
    <string name="video_quality_description_uhd">Video quality is ultra high definition</string>

    <!-- Accessibility label for the round quick settings button on the capture screen while the quick settings bottom sheet is open; tapping the button closes it. "open" is an adjective describing the state of the quick settings panel (it is open), not the imperative verb "open". [CHAR LIMIT=NONE] -->
    <string name="quick_settings_toggle_open_description">Quick settings open</string>
    <!-- Accessibility label for the round quick settings button on the capture screen while the quick settings bottom sheet is closed; tapping the button opens it. "closed" is an adjective describing the state of the quick settings panel (it is closed), not a verb. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=NONE] -->
    <string name="quick_settings_toggle_closed_description">Quick settings closed</string>
    <!-- Accessibility action label (announced as "double-tap to [label]") for tapping the drag handle of the quick settings bottom sheet, or the dimmed area behind it, on the capture screen; the action dismisses the quick settings sheet. "Close" is an imperative verb; "expanded settings" refers to the open quick settings panel. [CHAR LIMIT=NONE] -->
    <string name="quick_settings_btn_close_expanded_settings_description">Close expanded settings</string>

    <!-- Short label in the quick settings panel indicating the front-facing camera lens is active. [CHAR LIMIT=20] -->
    <string name="quick_settings_front_camera_text">Front</string>
    <!-- Short label in the quick settings panel indicating the rear-facing camera lens is active. "Back" refers to the rear-facing camera on the back of the device, not the navigation action to go back. [CHAR LIMIT=20] -->
    <string name="quick_settings_back_camera_text">Back</string>
    <!-- Accessibility label for the round flip-camera button on the capture screen while the front-facing (selfie) camera is active; it names the current lens (a state), and tapping the button switches to the rear camera. Translate as a noun phrase ("the front camera"), not as a command to switch. "Camera" is a generic term. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=NONE] -->
    <string name="quick_settings_front_camera_description">Front Camera</string>
    <!-- Accessibility label for the round flip-camera button on the capture screen while the rear-facing camera is active; it names the current lens (a state), and tapping the button switches to the front camera. Translate as a noun phrase ("the back camera"), not as a command to switch. "Back" refers to the rear-facing camera on the back of the device, not the navigation action to go back. "Camera" is a generic term. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=NONE] -->
    <string name="quick_settings_back_camera_description">Back Camera</string>

    <string name="quick_settings_aspect_ratio_3_4" translatable="false">3:4</string>
    <string name="quick_settings_aspect_ratio_9_16" translatable="false">9:16</string>
    <string name="quick_settings_aspect_ratio_1_1" translatable="false">1:1</string>

    <!-- Accessibility label for the 3:4 aspect ratio option in quick settings. The English text is matched verbatim by automated UI tests and must not be edited; translate normally. [CHAR LIMIT=NONE] -->
    <string name="quick_settings_aspect_ratio_3_4_description" tools:ignore="HardCodedNumber">3 to 4 aspect ratio</string>
