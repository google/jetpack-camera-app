    <string name="fps_rationale_prefix">Fps</string>
    <!-- Feature name substituted into disabled setting rationale messages for Flash. [CHAR LIMIT=35] -->
    <string name="flash_rationale_prefix">Flash</string>
    <!-- Feature name substituted into disabled setting rationale messages for Flash On mode. [CHAR LIMIT=35] -->
    <string name="flash_on_rationale_prefix">Flash On</string>
    <!-- Feature name substituted into disabled setting rationale messages for Flash Auto mode. [CHAR LIMIT=35] -->
    <string name="flash_auto_rationale_prefix">Flash Auto</string>
    <!-- Feature name substituted into disabled setting rationale messages for Low Light Boost mode. [CHAR LIMIT=35] -->
    <string name="flash_llb_rationale_prefix">Low Light Boost</string>

    <!-- Feature name substituted into disabled setting rationale messages for Video Quality. [CHAR LIMIT=35] -->
    <string name="video_quality_rationale_prefix">Video quality</string>
    <!-- Phrase substituted into disabled setting rationale messages referring to the currently selected dynamic range. [CHAR LIMIT=45] -->
    <string name="video_quality_rationale_suffix_default">the current dynamic range</string>
    <!-- Abbreviation for Standard Dynamic Range substituted into disabled setting rationale messages. [CHAR LIMIT=20] -->
    <string name="video_quality_rationale_suffix_sdr">SDR</string>

    <!-- Feature name substituted into disabled setting rationale messages for the front-facing camera lens. [CHAR LIMIT=35] -->
    <string name="front_lens_rationale_prefix">Front lens</string>
    <!-- Feature name substituted into disabled setting rationale messages for the rear-facing camera lens. [CHAR LIMIT=35] -->
    <string name="rear_lens_rationale_prefix">Rear lens</string>
    <!-- Feature name substituted into disabled setting rationale messages for fixed frame rate options. [CHAR LIMIT=35] -->
    <string name="no_fixed_fps_rationale_prefix">Fixed frame rate</string>

    <!-- Feature name substituted into disabled setting rationale messages for audio mute/recording. [CHAR LIMIT=35] -->
    <string name="mute_audio_rationale_prefix">Mute</string>
    <!-- Feature name substituted into disabled setting rationale messages for Concurrent Camera mode. [CHAR LIMIT=35] -->
    <string name="concurrent_camera_rationale_prefix">Concurrent camera</string>

    <!-- Disabled setting rationale message when a feature (%1$s) is unavailable because Video Stabilization is enabled. [CHAR LIMIT=80] -->
    <string name="stabilization_active_unsupported"><xliff:g id="setting_name" example="Concurrent camera">%1$s</xliff:g> is unsupported when Video Stabilization is enabled</string>
    <!-- Disabled setting rationale message when a feature (%1$s) is unavailable because a fixed frame rate is selected. [CHAR LIMIT=80] -->
    <string name="fixed_fps_active_unsupported"><xliff:g id="setting_name" example="Concurrent camera">%1$s</xliff:g> is unsupported when a fixed frame rate is selected</string>
